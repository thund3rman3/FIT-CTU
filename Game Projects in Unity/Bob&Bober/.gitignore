### Blender ###
# Ignore temporary Blender files.
/GlorpZorp/*.blend[0-9]*

### Unity ###
# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
/GlorpZorp/[Ll]ibrary/
/GlorpZorp/[Tt]emp/
/GlorpZorp/[Oo]bj/
/GlorpZorp/[Bb]uilds/
/GlorpZorp/[Ll]ogs/
/GlorpZorp/[Uu]ser[Ss]ettings/

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/GlorpZorp/[Mm]emoryCaptures/

# Recordings can get excessive in size
/GlorpZorp/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/GlorpZorp/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
/GlorpZorp/.vscode/
/GlorpZorp/.vs/
/GlorpZorp/.vsconfig

# Gradle cache directory
/GlorpZorp/.gradle/

# Autogenerated VS/MD/Consulo solution and project files
/GlorpZorp/ExportedObj/
/GlorpZorp/.consulo/
/GlorpZorp/*.csproj
/GlorpZorp/*.unityproj
/GlorpZorp/*.sln
/GlorpZorp/*.suo
/GlorpZorp/*.tmp
/GlorpZorp/*.user
/GlorpZorp/*.userprefs
/GlorpZorp/*.pidb
/GlorpZorp/*.booproj
/GlorpZorp/*.svd
/GlorpZorp/*.pdb
/GlorpZorp/*.mdb
/GlorpZorp/*.opendb
/GlorpZorp/*.VC.db

# Unity3D generated meta files
/GlorpZorp/*.pidb.meta
/GlorpZorp/*.pdb.meta
/GlorpZorp/*.mdb.meta

# Unity3D generated file on crash reports
/GlorpZorp/sysinfo.txt

# Builds
/GlorpZorp/*.apk
/GlorpZorp/*.aab
/GlorpZorp/*.unitypackage
/GlorpZorp/*.app

# Crashlytics generated file
/GlorpZorp/crashlytics-build.properties

# Packed Addressables
/GlorpZorp/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/GlorpZorp/[Aa]ssets/[Ss]treamingAssets/aa.meta
/GlorpZorp/[Aa]ssets/[Ss]treamingAssets/aa/*